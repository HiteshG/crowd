# OpenAI credentials for LLM persona generation and LLM reaction simulation.
# Copy this file to .env and fill in your real key. Do not commit .env.
OPENAI_API_KEY=sk-your-key-here

# User-preferred model for this harness.
OPENAI_MODEL=gpt-5.6-luna

# Reasoning effort for LLM reaction/report calls.
OPENAI_REASONING_EFFORT=medium

# Concurrent persona reaction calls per episode for --engine llm.
AUDIENCE_SIM_MAX_WORKERS=8

# Optional explicit fallback list. Empty means no silent fallback.
OPENAI_MODEL_FALLBACKS=

# Optional run defaults are still controlled by CLI flags:
# --persona-mode llm
# --engine llm
# --report-mode llm
